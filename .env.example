# Bawarii platform base URL: the host of the Bawarii sandbox API you were
# given access to.
BAWARII_API_BASE_URL=https://sandbox.api.bawarii.com
BAWARII_API_KEY=replace-me
BAWARII_WEBHOOK_SECRET=replace-me
REFERENCE_BACKEND_PORT=8000
# Public HTTPS URL of this backend (your tunnel URL). Needed for physical
# devices; simulators and emulators can leave it empty.
REFERENCE_BACKEND_PUBLIC_URL=
LOG_LEVEL=INFO
